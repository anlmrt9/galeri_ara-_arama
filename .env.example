# OtoGaleri Avcı Botu - ortam değişkeni şablonu
# ============================================
# Bu dosyayı `.env` olarak kopyalayın ve doldurun. `.env` git'e EKLENMEZ.
#   cp .env.example .env

# ---------- VERİTABANI ----------
# Bulut (PostgreSQL / Supabase). Tanımlıysa SQL Server ayarları yok sayılır.
# DATABASE_URL=postgresql://postgres:SIFRE@db.xxxx.supabase.co:5432/postgres

# Yerel SQL Server (yalnızca Windows geliştirme) — DATABASE_URL boşsa kullanılır
OTOGALERI_DB_SERVER=MERTPC\SQLEXPRESS
OTOGALERI_DB_NAME=OtoGaleriDB

# ---------- SCRAPER ----------
OTOGALERI_TIMEOUT=15
OTOGALERI_CYCLE_INTERVAL=60
OTOGALERI_MAX_NEW=5
OTOGALERI_PAGE_WAIT=2
OTOGALERI_SELENIUM_WAIT=5

# ---------- DB POOL / RETRY ----------
OTOGALERI_DB_POOL_SIZE=10
OTOGALERI_DB_MAX_OVERFLOW=20
OTOGALERI_DB_RECYCLE=3600
OTOGALERI_DB_TIMEOUT=20
OTOGALERI_RETRY_ATTEMPTS=3
OTOGALERI_RETRY_BACKOFF=2

# ---------- BİLDİRİM ----------
OTOGALERI_FAILURE_COOLDOWN=15
OTOGALERI_NOTIFICATIONS_ENABLED=true

# ---------- LOG ----------
OTOGALERI_LOG_FILE=otogaleri_log.txt
OTOGALERI_LOG_LEVEL=INFO
OTOGALERI_LOG_MAX_BYTES=5000000
OTOGALERI_LOG_BACKUP_COUNT=3

# ---------- API (api.py) ----------
# Boş bırakılırsa API kimlik doğrulaması KAPALIDIR (yalnızca güvenli yerel ağ için).
# Bir değer verirseniz mobil uygulama isteklerinde `X-API-Key` başlığı zorunlu olur.
OTOGALERI_API_KEY=
# Virgülle ayrılmış izinli origin listesi; "*" hepsi anlamına gelir.
OTOGALERI_CORS_ORIGINS=*
