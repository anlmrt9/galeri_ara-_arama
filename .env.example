# OtoGaleri Avcı Botu — ortam değişkeni şablonu
# =============================================
#   cp .env.example .env      (.env git'e EKLENMEZ)
# Tüm değişkenler opsiyoneldir; boş bırakılanlar varsayılanı kullanır.

# ---------- VERİTABANI (öncelik sırası) ----------
# 1) DATABASE_URL doluysa o kullanılır (PostgreSQL / Supabase):
# DATABASE_URL=postgresql+psycopg2://otogaleri:otogaleri@localhost:5432/otogaleri
# 2) Değilse ve OTOGALERI_DB_SERVER doluysa yerel SQL Server (Windows Authentication):
# OTOGALERI_DB_SERVER=BILGISAYARADI\SQLEXPRESS
# OTOGALERI_DB_NAME=OtoGaleriDB
# OTOGALERI_ODBC_DRIVER=            # boşsa kurulu en yeni "ODBC Driver XX" bulunur
# 3) Hiçbiri yoksa proje kökünde SQLite:
# OTOGALERI_SQLITE_PATH=otogaleri.db
# Docker Compose'daki PostgreSQL parolası:
# POSTGRES_PASSWORD=otogaleri

# ---------- TARAMA ----------
# OTOGALERI_CYCLE_INTERVAL=300       # turlar arası bekleme (sn)
# OTOGALERI_MAX_PAGES=3              # site başına taranan liste sayfası
# OTOGALERI_MAX_DETAIL=15            # site başına tur başına açılan en fazla detay sayfası
# OTOGALERI_TIMEOUT=20               # HTTP zaman aşımı (sn)
# OTOGALERI_REQUEST_MIN_INTERVAL=1.0 # aynı istemciden iki istek arası en az bekleme (sn)
# OTOGALERI_RETRY_ATTEMPTS=3
# OTOGALERI_SELENIUM_WAIT=6          # VavaCars sayfa render bekleme (sn)

# ---------- WORKER ----------
# true: API/Streamlit süreci taramayı kendi içinde yürütür (tek makine için yeterli)
# false: ayrı süreç gerekir ->  python -m otogaleri.worker
# OTOGALERI_EMBEDDED_WORKER=true
# OTOGALERI_JOB_STALE_AFTER=120      # bu kadar sn kalp atışı yoksa iş devralınır

# ---------- BİLDİRİM ----------
# OTOGALERI_NOTIFICATIONS_ENABLED=true
# OTOGALERI_DESKTOP_NOTIFICATIONS=true   # yalnızca Windows
# OTOGALERI_FAILURE_COOLDOWN=15          # aynı site hata bildirimi aralığı (dk)
# OTOGALERI_PRICE_DROP_MIN_PCT=1.0       # bildirilecek en küçük fiyat düşüşü (%)
# Telegram: @BotFather'dan token, @userinfobot'tan chat id
# OTOGALERI_TELEGRAM_BOT_TOKEN=
# OTOGALERI_TELEGRAM_CHAT_ID=
# E-posta (SMTP)
# OTOGALERI_SMTP_HOST=smtp.gmail.com
# OTOGALERI_SMTP_PORT=587
# OTOGALERI_SMTP_USER=
# OTOGALERI_SMTP_PASSWORD=               # Gmail için "uygulama şifresi"
# OTOGALERI_SMTP_FROM=
# OTOGALERI_SMTP_TO=

# ---------- LOG / İZLEME ----------
# OTOGALERI_LOG_LEVEL=INFO
# OTOGALERI_LOG_FILE=otogaleri_log.txt   # boş = yalnızca konsol
# OTOGALERI_LOG_JSON=false
# OTOGALERI_SENTRY_DSN=                  # pip install "otogaleri-avci-botu[sentry]"

# ---------- REST API ----------
# Tanımlı değilse API yalnızca localhost'tan gelen istekleri kabul eder.
# Mobil uygulama / yerel ağ erişimi için güçlü bir anahtar üretin:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# OTOGALERI_API_KEY=
# OTOGALERI_API_ALLOW_UNAUTHENTICATED=false
# OTOGALERI_CORS_ORIGINS=                # virgülle ayrılmış origin listesi; boş = CORS kapalı
# OTOGALERI_RATE_LIMIT=120               # IP başına dakikada istek
