# .streamlit/secrets.toml — Streamlit Cloud Secrets şablonu
# ==========================================================
# Streamlit Cloud → App Settings → Secrets bölümüne yapıştırın.
# Yerelde .streamlit/secrets.toml olarak kaydedebilirsiniz (git'e EKLENMEZ).
# Diğer tüm ayarlar için .env.example dosyasına bakın.

# Supabase → Settings → Database → Connection string (URI)
DATABASE_URL = "postgresql://postgres:SIFRENIZ@db.XXXX.supabase.co:5432/postgres"
