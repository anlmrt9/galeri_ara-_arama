# .streamlit/secrets.toml — Streamlit Cloud Secrets Şablonu
# ============================================================
# Bu dosyayı Streamlit Cloud → App Settings → Secrets bölümüne yapıştırın.
# Yerel geliştirme için bu dosyayı .streamlit/secrets.toml olarak kaydedin
# (Git'e EKLEMEYİN, .gitignore'da tutulur).

# --- PostgreSQL / Supabase ---
# Supabase → Settings → Database → Connection String → URI kısmından alın:
DATABASE_URL = "postgresql://postgres:SIFRENIZ@db.XXXX.supabase.co:5432/postgres"

# --- Alternatif: Lokal SQL Server (sadece Windows geliştirme) ---
# Aşağıdaki satırları DATABASE_URL yerine kullanın:
# OTOGALERI_DB_SERVER = "MERTPC\\SQLEXPRESS"
# OTOGALERI_DB_NAME   = "OtoGaleriDB"
